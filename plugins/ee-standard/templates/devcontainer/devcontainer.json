{
  // The ee-standard devcontainer template. Copy this directory to
  // `.devcontainer/` in a new repository, replace every double-brace
  // placeholder — `grep -rl '{{' .devcontainer` lists them — then run
  // `/gate-build` to pin what you chose and stamp it.
  //
  // This file chooses nothing on your behalf beyond the base image, and pins
  // everything it does choose. `project-init` decides which image and which
  // features a project needs; `gate-build` insists that whichever were chosen
  // are pinned; this template is what exists before either has run.
  "name": "{{PROJECT_NAME}} Dev Environment",

  // DEV-001 — pinned by digest, not by floating tag. No lock file covers
  // images, so this is the one pin that must live inline.
  //
  // mcr.microsoft.com/devcontainers/base:trixie, resolved from the registry on
  // 2026-08-21. Bumps arrive as pull requests via SUP-002's `devcontainers`
  // ecosystem — a pin nothing updates rots at a known version, which is a
  // different failure from an unpinned one and not a better one.
  "image": "mcr.microsoft.com/devcontainers/base:trixie@sha256:025b74bb5f7ac53edd77e01aa7188c359aab100e23a2f6220bde50bbb9fd31dd",

  // Language toolchains are added **when a language is actually introduced**,
  // not in anticipation. The register's predicates already model this: a repo
  // with no `*.tf` skips IAC-001, and by the same logic it has no business
  // installing OpenTofu. `github-cli` is here because every repository needs it
  // and nothing in this file is a language choice.
  //
  // Features are pinned by devcontainer-lock.json, regenerated with:
  //   devcontainer upgrade --workspace-folder .
  //
  // A lock file covering *some* features reads as solved and is not — DEV-001
  // fails one, and this project's own Phase 0.5 exit criterion was re-opened
  // over exactly that.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Secrets are fetched on the host and never committed. Both generated files
  // are gitignored by the `.gitignore` in this directory; SEC-001 depends on
  // those lines staying there.
  "initializeCommand": "bash .devcontainer/fetch-secrets.sh",

  // The `.docker` copy, not the `.env` itself. `--env-file` does no shell
  // parsing, so it would read a quoted value's quotes as part of the value; the
  // `.env` is sourced as shell, where the quotes are required. One fetch writes
  // the first and derives the second, so there is one thing to keep correct.
  "runArgs": ["--env-file", ".devcontainer/.env.docker"],

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/check-auth.sh",

  // BLD-001 — the container's final user is not root. Stated rather than
  // inherited: a devcontainer naming neither `containerUser` nor `remoteUser`
  // runs as whatever its base image uses, which may be root today and may
  // become root on any digest bump. Non-root by luck is not the property.
  "remoteUser": "vscode",

  // Credential state survives a rebuild. Without this, every rebuild is
  // followed by a re-authentication ritual, and rituals get skipped.
  "mounts": [
    "source={{PROJECT_NAME}}-claude-home,target=/home/vscode/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      // Left empty on purpose. The editor locus belongs to the controls that
      // declare one, and `gate-quality` writes the extension its register names
      // — one list, not two. An extension added here by hand is a second
      // statement of what the editor enforces.
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
