{
  "name": "ee-standard Dev Environment",

  // ee-control: DEV-001  ee-skill: gate-build@0.1.0  register: v0.15.0  register-contract: 15
  //
  // Adopted, not deployed: hand-written in Phase 0.5 and stamped when the gate
  // that owns it was built. One stamp per key rather than one at the top of the
  // file — `gate-quality` owns the editor extensions further down, and a
  // whole-file stamp would claim them.
  //
  // DEV-001 — the image is pinned by digest, not by floating tag. No lock file
  // covers images, so this is the one pin that must live inline.
  // mcr.microsoft.com/devcontainers/base:trixie, resolved 2026-08-16.
  "image": "mcr.microsoft.com/devcontainers/base:trixie@sha256:025b74bb5f7ac53edd77e01aa7188c359aab100e23a2f6220bde50bbb9fd31dd",

  // Features are pinned by devcontainer-lock.json, generated on first build:
  //   devcontainer upgrade --workspace-folder .
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {},
    // Bootstrap, not the project interpreter: this installs the `python3` that
    // runs `pip install uv` in setup.sh. The interpreter the gates run on is
    // `.python-version`, and uv resolves it (ADR 0027) — the register pins the
    // toolchain file and deliberately not this line, so nothing here is
    // *asserted* equal to it.
    //
    // Held at the same value all the same, from ADR 0028 revision 2. Not
    // asserting an equality and not wanting one are different things, and
    // lagging bought nothing: a bare `python3` in a login shell is this
    // interpreter, and a first-party script reached that way ran below the
    // support floor while every gate passed.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // The project environment lives in the container layer, not in the workspace
  // bind mount. `.venv/` at the repository root is on the host filesystem, so it
  // outlives the container that built it: the 2026-08-24 rebuild moved the
  // python feature 3.13 -> 3.14, `/usr/local/python/current/bin/python3.13`
  // stopped existing, and uv found `.venv/bin/python` dangling —
  //   warning: Ignoring existing virtual environment linked to non-existent
  //   Python interpreter: .venv/bin/python3 -> python
  // — then deleted and rebuilt it. That recovery is correct, and its timing is
  // the problem: the delete/rebuild happens inside `postCreateCommand`, which
  // runs concurrently with the editor's extension host. The ruff extension
  // resolved `.venv/bin/python`, got ENOENT, and fell back to its own bundled
  // ruff for the rest of the session — so the editor locus LNT-001 declares ran
  // an unpinned binary while pre-commit and CI ran the one uv.lock owns. It
  // happened to be the same version; nothing made it so.
  //
  // Relocating the environment does not close the race — nothing here can, with
  // no Dockerfile to build the environment into the image — but it removes the
  // stale half. A container-layer path is absent on a rebuild and present on
  // every restart thereafter, where a bind-mounted one is stale on a rebuild and
  // deleted mid-boot, which is the window the extension activates in.
  //
  // Set as containerEnv rather than remoteEnv so lifecycle scripts, terminals,
  // pre-commit hooks and the editor all resolve the same environment. CI never
  // reads this file, so `uv run` there is unaffected.
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv-ee-standard"
  },

  "initializeCommand": "bash .devcontainer/fetch-secrets.sh",

  // The .docker copy, not the .env itself: --env-file does no shell parsing,
  // so it would take a quoted value's quotes as part of the value. Both files
  // come from one Keychain fetch — see .devcontainer/fetch-secrets.sh.
  "runArgs": ["--env-file", ".devcontainer/.env.docker"],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/check-auth.sh",

  // ee-control: BLD-001  ee-skill: gate-build@0.1.0  register: v0.15.0  register-contract: 15
  //
  // BLD-001 — the container's final user is not root. Stated rather than
  // inherited: relying on the base image's default is the declared-but-
  // unreachable shape this register exists to catch.
  "remoteUser": "vscode",

  "mounts": [
    "source=ee-standard-claude-home,target=/home/vscode/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      // ee-control: LNT-001  ee-skill: gate-quality@0.1.0  register: v0.12.0  register-contract: 12
      //
      // Adopted, not deployed — and the only artefact `gate-quality` writes
      // that is not a hook or a workflow step. LNT-001 is the one control of
      // the three declaring an `editor` locus, so the stamp names it alone.
      //
      // The editor locus, for the two controls that declare one. Each reads
      // the same configuration pre-commit and CI read — pin once, reference
      // many, rather than an editor with rules of its own.
      //   LNT-001 — ruff, from [tool.ruff] in pyproject.toml
      //   DOC-001 — markdownlint, from .markdownlint.yaml
      //
      // Installing the extension is all this file does for that locus. Which
      // tool holds a gated file type is settled in .vscode/settings.json, at
      // workspace scope — the containers.dev merge table specifies no rule for
      // `customizations`, so a binding written here would compete with a
      // feature's on undefined terms (ADR 0029).
      "extensions": ["charliermarsh.ruff", "DavidAnson.vscode-markdownlint"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",

        // Nothing in this repository serves anything. Every port the rebuild
        // forwarded was one of the editor's own loopback services — code-server,
        // the extension host, the agent host, the Pylance server — each bound
        // with `--port 0`, so the numbers differ on every container start and the
        // forwarded list reads as though it were accumulating.
        "remote.autoForwardPorts": false
      }
    }
  }
}
