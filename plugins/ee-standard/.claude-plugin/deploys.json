        ".pre-commit-config.yaml#lint",
        ".pre-commit-config.yaml#typecheck",
        ".github/workflows/standard-check.yml#lint",
        ".github/workflows/standard-check.yml#type-check",
        ".github/workflows/standard-check.yml#tests"
      ]
    }
  }
